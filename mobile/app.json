{
  "expo": {
    "name": "Stoke",
    "slug": "stoke-study",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "stoke",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stoke.study"
    },
    "android": {
      "package": "com.stoke.study",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#7c3aed"
      }
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "webAppUrl": "http://stoke-study.runasp.net",
      "router": {},
      "eas": {
        "projectId": "3750d619-84ad-4e8f-a955-ed98841883ed"
      }
    }
  }
}
