<?xml version="1.0" encoding="utf-8"?>
<!--
  MonsterASP.NET deployment for the Stoke Next.js app.
  Upload the CONTENTS of .next/standalone/ PLUS public/ and .next/static
  (copied per https://nextjs.org/docs/app/api-reference/config/next-config-js/output)
  together with THIS file into /wwwroot via FTP, so /wwwroot holds:
    server.js, web.config, package.json, public/, .next/, node_modules/, data/
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="node" arguments=".\server.js" startupTimeLimit="60" stdoutLogEnabled="false" stdoutLogFile=".\logs\node">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
        <!-- Database: file-based SQLite persists on the site's own disk, so
             Turso is optional here. Leave these two lines commented out to use
             data/stoke.db, or fill them in to use Turso instead. -->
        <!--
        <environmentVariable name="TURSO_DATABASE_URL" value="libsql://YOUR-DB.turso.io" />
        <environmentVariable name="TURSO_AUTH_TOKEN" value="YOUR-TOKEN" />
        -->
        <!-- Optional: server-wide Groq key so students never need their own. -->
        <!--
        <environmentVariable name="GROQ_API_KEY" value="gsk_..." />
        -->
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
