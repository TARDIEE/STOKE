# Copy this file to .env.local for local development, and add the same
# variables in Vercel: Project Settings -> Environment Variables.

# Database: local SQLite file is used when these are empty (fine for localhost).
# On Vercel you MUST set these to a free Turso database (https://turso.tech),
# otherwise accounts and study data vanish on every deploy (ephemeral filesystem).
# TURSO_DATABASE_URL=libsql://your-db-username.turso.io
# TURSO_AUTH_TOKEN=

# Optional: server-wide AI key fallback (students can also paste their own
# free Groq key in Settings → AI generation).
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
