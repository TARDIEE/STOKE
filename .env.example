# Copy this file to .env.local for local development, and add the same
# variables in Vercel: Project Settings -> Environment Variables.

# Required for the contact form to actually deliver messages in production.
# Sign up free at https://web3forms.com, submit your email, and it emails
# you an access key (no domain verification needed).
WEB3FORMS_ACCESS_KEY=

# Optional: where contact form messages should be emailed. Defaults to the
# email in lib/content.ts (profile.email) if not set.
CONTACT_TO_EMAIL=

# Optional: protects /admin/messages behind a "?token=" query parameter.
# Leave empty during local development to view it freely.
ADMIN_TOKEN=

# Optional: used for absolute URLs in page metadata (Open Graph, etc).
NEXT_PUBLIC_SITE_URL=

# Database: local SQLite file is used when these are empty (fine for localhost).
# On Vercel you MUST set these to a free Turso database (https://turso.tech),
# otherwise accounts and study data vanish on every deploy (ephemeral filesystem).
# TURSO_DATABASE_URL=libsql://your-db-username.turso.io
# TURSO_AUTH_TOKEN=

# Optional: server-wide AI key fallback (students can also paste their own
# free Groq key in Settings → AI generation).
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
